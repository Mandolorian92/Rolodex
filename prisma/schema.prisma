// Prisma schema for Rolodex — a price-tracking "ticker" for trading card collections.
//
// Several kinds of price data feed the ticker, and they're deliberately kept in one merged
// timeline (PriceSnapshot) rather than treating the guide price as primary and everything
// else as a side note: PriceCharting's per-condition guide price (an aggregate that can lag
// real demand), actual recent sold transactions (PriceCharting's own marketplace, and eBay
// when configured), and TCGPlayer's own Market Price (Magic/Pokemon/Yu-Gi-Oh only) — see
// PriceSource. Individual sold comps are also kept in MarketSale with their listing details
// (title/link/image) for display, but the price itself is mirrored into PriceSnapshot so
// the trend engine reacts to real sales exactly like it reacts to a guide-price move.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Accounts: the multi-tenant foundation. Card/PriceSnapshot/MarketSale stay
// deliberately unscoped by user — they're a shared catalog, not personal data, so two
// users who both own a Base Set Charizard share its price history instead of each
// triggering their own PriceCharting/TCGPlayer sync. Only ownership (CollectionItem,
// WatchTarget) and personal signals (Alert) are scoped to a user.
//
// userId is nullable for now, deliberately: this schema shipped after real single-user
// data already existed (locally and for early users), and Postgres can't backfill a
// NOT NULL column with a meaningful value on its own. The migration path is: (1) this
// migration, purely additive; (2) each existing user claims their pre-auth data via a
// one-time backfill once they have an account; (3) a follow-up migration tightens these
// to required. Don't build new features that assume userId is always present until that
// follow-up lands — see README.

// Auth.js (next-auth v5) Prisma adapter schema — standard shape, do not rename fields.
model User {
  id            String    @id @default(cuid())
  // The onboarding "give username" step — distinct from `name`/`email` so a user can pick
  // a public handle independent of their sign-in email.
  username      String?   @unique
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts        Account[]
  sessions        Session[]
  collectionItems CollectionItem[]
  watchTargets    WatchTarget[]
  alerts          Alert[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// A single card, identified independent of any one vendor's catalog. `priceChartingId` was
// originally the primary key in spirit (required + unique); it's now one optional external
// reference among several, so a card can enter the catalog from PriceCharting, a ManaBox
// export, a free TCG catalog (Scryfall/pokemontcg.io — not wired up yet), a scan, or a user
// just typing it in, without any one of those being required. Pricing still comes from
// wherever it comes from (PriceCharting/eBay/TCGPlayer/manual) independent of which external
// ref(s), if any, a card happens to have.
model Card {
  id               String    @id @default(cuid())
  priceChartingId  String?   @unique @map("pricecharting_id")
  // Magic's canonical id (scryfall.com) — ManaBox exports already carry this for Magic cards
  // (see src/lib/manabox.ts), so it costs nothing extra to store; a real Scryfall API search
  // integration for the add-card flow is a separate follow-up, not built yet.
  scryfallId       String?   @unique @map("scryfall_id")
  // Pokémon's canonical id (pokemontcg.io) — no integration populates this yet; reserved for
  // the same follow-up as scryfallId above.
  pokemonTcgId     String?   @unique @map("pokemontcg_id")
  // ManaBox's own row id, when a card has neither a real PriceCharting id nor a Scryfall id
  // (e.g. non-Magic rows in an export) — the fallback identity so re-imports still dedupe.
  manaboxId        String?   @unique @map("manabox_id")
  name             String
  consoleName      String?   @map("console_name") // e.g. "Pokemon Base Set", "Magic: Alpha"
  category         String? // e.g. "pokemon-card", "sports-card", "magic-card" — see src/lib/cardMeta.ts
  // Best-effort language guess parsed from the product/console name (e.g. "French",
  // "Japanese") — see detectLanguage() in src/lib/cardMeta.ts. Null means English/unknown;
  // most catalogs don't mark English cards explicitly, so absence isn't a hard signal.
  language         String?
  imageUrl         String?   @map("image_url")
  // Print variant detected from the product name (e.g. "Holo", "Reverse Holo", "Cosmos
  // Holo") — see src/lib/variants.ts. Used to find same-card/different-variant siblings
  // and flag when one is worth meaningfully more, in case a card was mislabeled/scanned
  // as the wrong print.
  variantLabel     String?   @map("variant_label")
  variantCheckedAt DateTime? @map("variant_checked_at")
  // TCGPlayer's own catalog id for this card, once matched — see src/lib/tcgplayer.ts.
  // Cached so sync doesn't re-search the catalog every run; tcgplayerCheckedAt gates how
  // often a failed/stale match gets retried (mirrors variantCheckedAt's staleness pattern).
  // Unique like the other external refs above — a TCGPlayer export import (see
  // src/lib/tcgplayerImport.ts) keys off this the same way ManaBox import keys off
  // manaboxId, so a re-import always lands on the same Card instead of drifting.
  tcgplayerProductId String?   @unique @map("tcgplayer_product_id")
  tcgplayerCheckedAt DateTime? @map("tcgplayer_checked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  collectionItems CollectionItem[]
  priceSnapshots  PriceSnapshot[]
  marketSales     MarketSale[]
  alerts          Alert[]

  @@map("cards")
}

// A card a user owns, with quantity/condition/cost-basis. userId nullable during the
// multi-tenant migration — see the note above the User model.
model CollectionItem {
  id            String    @id @default(cuid())
  userId        String?   @map("user_id")
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId        String    @map("card_id")
  card          Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  quantity      Int       @default(1)
  condition     Condition @default(NEAR_MINT)
  purchasePrice Int?      @map("purchase_price") // cents
  purchasedAt   DateTime? @map("purchased_at")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Was @@unique([cardId, condition]) pre-multi-tenant — a card+condition could only be
  // owned once, globally. Now scoped per user, since two different users can each own a
  // Near Mint copy of the same card.
  @@unique([userId, cardId, condition])
  @@index([cardId])
  @@map("collection_items")
}

// Grading tiers match PriceCharting's own price fields for cards: below grade 10 they
// only publish one aggregate price per tier regardless of grading company, but at 10 they
// split by grader (PSA/BGS/CGC/SGC each get their own price field) — see
// CARD_PRICE_TYPE_LABELS in src/lib/pricecharting.ts and the mapping in src/lib/grades.ts.
enum Condition {
  UNGRADED
  NEAR_MINT
  LIGHTLY_PLAYED
  MODERATELY_PLAYED
  HEAVILY_PLAYED
  DAMAGED
  GRADED_7
  GRADED_8
  GRADED_9
  PSA_10
  BGS_10
  CGC_10
  SGC_10
}

// A point-in-time price observation for a card, from a given source/price type. This is
// the merged time series that powers the ticker and trend engine — both periodic guide
// price pulls AND individual sold transactions land here, at their real timestamps, so a
// sale that beats the guide price shows up as a spike/new-high immediately rather than
// waiting for PriceCharting's aggregate to catch up.
model PriceSnapshot {
  id         String      @id @default(cuid())
  cardId     String      @map("card_id")
  card       Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  source     PriceSource
  priceType  String      @map("price_type") // e.g. "loose", "cib", "new", "graded-9", "graded-10"
  price      Int // cents
  capturedAt DateTime    @default(now()) @map("captured_at")

  @@index([cardId, priceType, capturedAt])
  @@map("price_snapshots")
}

enum PriceSource {
  /// PriceCharting's aggregate per-condition guide price (/api/product). Can lag real demand.
  PRICECHARTING_GUIDE
  /// An actual sold transaction on PriceCharting's own marketplace (/api/offers?status=sold).
  PRICECHARTING_SALE
  /// An actual sold transaction on eBay.
  EBAY_SALE
  /// TCGPlayer's aggregate Market Price for a product — itself computed from recent sales,
  /// so it's a second independent real-market signal alongside PriceCharting's guide price
  /// and eBay sold comps. Magic/Pokemon/Yu-Gi-Oh only — TCGPlayer doesn't carry sports
  /// cards. See src/lib/tcgplayer.ts.
  TCGPLAYER_MARKET
  MANUAL
}

// An individual sold transaction — PriceCharting's own marketplace, or eBay — kept with its
// full listing details (title/link/image) for display. Its price is also mirrored into
// PriceSnapshot (see above) so it drives the trend engine like any other price point.
model MarketSale {
  id        String      @id @default(cuid())
  cardId    String      @map("card_id")
  card      Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  source    PriceSource
  title     String
  price     Int // cents
  itemUrl   String      @map("item_url")
  imageUrl  String?     @map("image_url")
  condition String?
  soldAt    DateTime    @map("sold_at")
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([itemUrl])
  @@index([cardId, soldAt])
  @@map("market_sales")
}

// A generated signal — "trending up", "time to sell", etc — surfaced from the trend engine.
// One row per owning user (not deduplicated across owners of the same card): `acknowledged`
// is inherently per-user — if two users own the same card, one dismissing a shared signal
// must not hide it for the other. userId nullable during the multi-tenant migration — see
// the note above the User model.
model Alert {
  id           String    @id @default(cuid())
  userId       String?   @map("user_id")
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId       String    @map("card_id")
  card         Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  type         AlertType
  priceType    String    @map("price_type")
  message      String
  changePct    Float     @map("change_pct")
  fromPrice    Int       @map("from_price") // cents
  toPrice      Int       @map("to_price") // cents
  windowDays   Int       @map("window_days")
  acknowledged Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([cardId, createdAt])
  @@index([userId, acknowledged, createdAt])
  @@map("alerts")
}

enum AlertType {
  TRENDING_UP
  TRENDING_DOWN
  SELL_SIGNAL
  NEW_HIGH
  /// A same-card different-print-variant sibling (e.g. Cosmos Holo vs Holo) is priced
  /// meaningfully higher than what's on file — possible mislabeled/misidentified variant.
  VARIANT_MISMATCH
  /// A raw/ungraded card's graded value clears the grading-cost floor with a holding or
  /// rising trend — see src/lib/gradingRecs.ts.
  GRADING_OPPORTUNITY
}

// --- Stock watch: a separate feature from card price tracking above. Watches specific
// retail product/search pages and alerts on restocks or brand-new listings (e.g. a new
// Pokemon Elite Trainer Box going live at GameStop/Walmart/Target/Best Buy) — see
// src/lib/stockWatch.ts and src/lib/retailers/. Deliberately notify-only: it never adds to
// cart or checks out, since that crosses into scalper-bot territory.

enum Retailer {
  GAMESTOP
  WALMART
  TARGET
  BESTBUY
}

enum WatchKind {
  /// A specific known product page — alert when it flips from out-of-stock to in-stock.
  PRODUCT
  /// A search/category page for a keyword (e.g. "Elite Trainer Box") — alert when a
  /// brand-new listing appears that wasn't there on the last check.
  SEARCH
}

// A retailer page a user wants watched, checked on a schedule (see stockWatch.ts). Unlike
// Card, this is inherently personal (not a shared catalog), so SeenProduct/StockAlert don't
// need their own userId — they're already scoped via watchTargetId. userId nullable during
// the multi-tenant migration — see the note above the User model.
model WatchTarget {
  id            String    @id @default(cuid())
  userId        String?   @map("user_id")
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  retailer      Retailer
  kind          WatchKind @default(PRODUCT)
  label         String
  url           String
  // Best Buy SKU, when known — lets the checker use Best Buy's official Products API
  // directly instead of scraping. Required for BESTBUY + PRODUCT.
  sku           String?
  // Search keyword, required for SEARCH kind (e.g. "Pokemon Elite Trainer Box").
  keyword       String?
  active        Boolean   @default(true)
  // Last known stock state for PRODUCT targets. Null = not checked yet.
  inStock       Boolean?
  lastTitle     String?
  lastPriceCents Int?     @map("last_price_cents")
  lastCheckedAt DateTime? @map("last_checked_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  seenProducts SeenProduct[]
  stockAlerts  StockAlert[]

  // Was @@unique([url]) pre-multi-tenant — now two different users can each watch the same
  // retail URL independently.
  @@unique([userId, url])
  @@map("watch_targets")
}

// A product already seen on a SEARCH-kind target, so only genuinely new listings alert.
model SeenProduct {
  id            String      @id @default(cuid())
  watchTargetId String      @map("watch_target_id")
  watchTarget   WatchTarget @relation(fields: [watchTargetId], references: [id], onDelete: Cascade)
  externalId    String      @map("external_id") // sku or product URL, used to dedupe
  title         String
  url           String
  firstSeenAt   DateTime    @default(now()) @map("first_seen_at")

  @@unique([watchTargetId, externalId])
  @@map("seen_products")
}

// A generated restock/new-listing signal for a watch target.
model StockAlert {
  id            String      @id @default(cuid())
  watchTargetId String      @map("watch_target_id")
  watchTarget   WatchTarget @relation(fields: [watchTargetId], references: [id], onDelete: Cascade)
  message       String
  url           String
  acknowledged  Boolean     @default(false)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([watchTargetId, createdAt])
  @@index([acknowledged, createdAt])
  @@map("stock_alerts")
}
