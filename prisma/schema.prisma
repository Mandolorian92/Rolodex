// Prisma schema for Rolodex — a price-tracking "ticker" for trading card collections.
//
// Two kinds of price data feed the ticker, and they're deliberately kept in one merged
// timeline (PriceSnapshot) rather than treating the guide price as primary and sales as a
// side note: PriceCharting's per-condition guide price (an aggregate that can lag real
// demand) and actual recent sold transactions (PriceCharting's own marketplace, and eBay
// when configured) — see PriceSource. Individual sold comps are also kept in MarketSale
// with their listing details (title/link/image) for display, but the price itself is
// mirrored into PriceSnapshot so the trend engine reacts to real sales exactly like it
// reacts to a guide-price move.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A single card/product as known by PriceCharting's catalog.
model Card {
  id               String    @id @default(cuid())
  priceChartingId  String    @unique @map("pricecharting_id")
  name             String
  consoleName      String?   @map("console_name") // e.g. "Pokemon Base Set", "Magic: Alpha"
  category         String? // e.g. "pokemon-card", "sports-card", "magic-card"
  imageUrl         String?   @map("image_url")
  // Print variant detected from the product name (e.g. "Holo", "Reverse Holo", "Cosmos
  // Holo") — see src/lib/variants.ts. Used to find same-card/different-variant siblings
  // and flag when one is worth meaningfully more, in case a card was mislabeled/scanned
  // as the wrong print.
  variantLabel     String?   @map("variant_label")
  variantCheckedAt DateTime? @map("variant_checked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  collectionItems CollectionItem[]
  priceSnapshots  PriceSnapshot[]
  marketSales     MarketSale[]
  alerts          Alert[]

  @@map("cards")
}

// A card the user owns, with quantity/condition/cost-basis.
model CollectionItem {
  id            String    @id @default(cuid())
  cardId        String    @map("card_id")
  card          Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  quantity      Int       @default(1)
  condition     Condition @default(NEAR_MINT)
  purchasePrice Int?      @map("purchase_price") // cents
  purchasedAt   DateTime? @map("purchased_at")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([cardId, condition])
  @@map("collection_items")
}

// Grading tiers match PriceCharting's own price fields for cards: below grade 10 they
// only publish one aggregate price per tier regardless of grading company, but at 10 they
// split by grader (PSA/BGS/CGC/SGC each get their own price field) — see
// CARD_PRICE_TYPE_LABELS in src/lib/pricecharting.ts and the mapping in src/lib/grades.ts.
enum Condition {
  UNGRADED
  NEAR_MINT
  LIGHTLY_PLAYED
  MODERATELY_PLAYED
  HEAVILY_PLAYED
  DAMAGED
  GRADED_7
  GRADED_8
  GRADED_9
  PSA_10
  BGS_10
  CGC_10
  SGC_10
}

// A point-in-time price observation for a card, from a given source/price type. This is
// the merged time series that powers the ticker and trend engine — both periodic guide
// price pulls AND individual sold transactions land here, at their real timestamps, so a
// sale that beats the guide price shows up as a spike/new-high immediately rather than
// waiting for PriceCharting's aggregate to catch up.
model PriceSnapshot {
  id         String      @id @default(cuid())
  cardId     String      @map("card_id")
  card       Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  source     PriceSource
  priceType  String      @map("price_type") // e.g. "loose", "cib", "new", "graded-9", "graded-10"
  price      Int // cents
  capturedAt DateTime    @default(now()) @map("captured_at")

  @@index([cardId, priceType, capturedAt])
  @@map("price_snapshots")
}

enum PriceSource {
  /// PriceCharting's aggregate per-condition guide price (/api/product). Can lag real demand.
  PRICECHARTING_GUIDE
  /// An actual sold transaction on PriceCharting's own marketplace (/api/offers?status=sold).
  PRICECHARTING_SALE
  /// An actual sold transaction on eBay.
  EBAY_SALE
  MANUAL
}

// An individual sold transaction — PriceCharting's own marketplace, or eBay — kept with its
// full listing details (title/link/image) for display. Its price is also mirrored into
// PriceSnapshot (see above) so it drives the trend engine like any other price point.
model MarketSale {
  id        String      @id @default(cuid())
  cardId    String      @map("card_id")
  card      Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  source    PriceSource
  title     String
  price     Int // cents
  itemUrl   String      @map("item_url")
  imageUrl  String?     @map("image_url")
  condition String?
  soldAt    DateTime    @map("sold_at")
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([itemUrl])
  @@index([cardId, soldAt])
  @@map("market_sales")
}

// A generated signal — "trending up", "time to sell", etc — surfaced from the trend engine.
model Alert {
  id           String    @id @default(cuid())
  cardId       String    @map("card_id")
  card         Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  type         AlertType
  priceType    String    @map("price_type")
  message      String
  changePct    Float     @map("change_pct")
  fromPrice    Int       @map("from_price") // cents
  toPrice      Int       @map("to_price") // cents
  windowDays   Int       @map("window_days")
  acknowledged Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([cardId, createdAt])
  @@index([acknowledged, createdAt])
  @@map("alerts")
}

enum AlertType {
  TRENDING_UP
  TRENDING_DOWN
  SELL_SIGNAL
  NEW_HIGH
  /// A same-card different-print-variant sibling (e.g. Cosmos Holo vs Holo) is priced
  /// meaningfully higher than what's on file — possible mislabeled/misidentified variant.
  VARIANT_MISMATCH
}
