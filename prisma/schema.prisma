// Prisma schema for Rolodex — a price-tracking "ticker" for trading card collections.
//
// Several kinds of price data feed the ticker, and they're deliberately kept in one merged
// timeline (PriceSnapshot) rather than treating the guide price as primary and everything
// else as a side note: PriceCharting's per-condition guide price (an aggregate that can lag
// real demand), actual recent sold transactions (PriceCharting's own marketplace, and eBay
// when configured), and TCGPlayer's own Market Price (Magic/Pokemon/Yu-Gi-Oh only) — see
// PriceSource. Individual sold comps are also kept in MarketSale with their listing details
// (title/link/image) for display, but the price itself is mirrored into PriceSnapshot so
// the trend engine reacts to real sales exactly like it reacts to a guide-price move.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A single card/product as known by PriceCharting's catalog.
model Card {
  id               String    @id @default(cuid())
  priceChartingId  String    @unique @map("pricecharting_id")
  name             String
  consoleName      String?   @map("console_name") // e.g. "Pokemon Base Set", "Magic: Alpha"
  category         String? // e.g. "pokemon-card", "sports-card", "magic-card" — see src/lib/cardMeta.ts
  // Best-effort language guess parsed from the product/console name (e.g. "French",
  // "Japanese") — see detectLanguage() in src/lib/cardMeta.ts. Null means English/unknown;
  // most catalogs don't mark English cards explicitly, so absence isn't a hard signal.
  language         String?
  imageUrl         String?   @map("image_url")
  // Print variant detected from the product name (e.g. "Holo", "Reverse Holo", "Cosmos
  // Holo") — see src/lib/variants.ts. Used to find same-card/different-variant siblings
  // and flag when one is worth meaningfully more, in case a card was mislabeled/scanned
  // as the wrong print.
  variantLabel     String?   @map("variant_label")
  variantCheckedAt DateTime? @map("variant_checked_at")
  // TCGPlayer's own catalog id for this card, once matched — see src/lib/tcgplayer.ts.
  // Cached so sync doesn't re-search the catalog every run; tcgplayerCheckedAt gates how
  // often a failed/stale match gets retried (mirrors variantCheckedAt's staleness pattern).
  tcgplayerProductId String?   @map("tcgplayer_product_id")
  tcgplayerCheckedAt DateTime? @map("tcgplayer_checked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  collectionItems CollectionItem[]
  priceSnapshots  PriceSnapshot[]
  marketSales     MarketSale[]
  alerts          Alert[]

  @@map("cards")
}

// A card the user owns, with quantity/condition/cost-basis.
model CollectionItem {
  id            String    @id @default(cuid())
  cardId        String    @map("card_id")
  card          Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  quantity      Int       @default(1)
  condition     Condition @default(NEAR_MINT)
  purchasePrice Int?      @map("purchase_price") // cents
  purchasedAt   DateTime? @map("purchased_at")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([cardId, condition])
  @@map("collection_items")
}

// Grading tiers match PriceCharting's own price fields for cards: below grade 10 they
// only publish one aggregate price per tier regardless of grading company, but at 10 they
// split by grader (PSA/BGS/CGC/SGC each get their own price field) — see
// CARD_PRICE_TYPE_LABELS in src/lib/pricecharting.ts and the mapping in src/lib/grades.ts.
enum Condition {
  UNGRADED
  NEAR_MINT
  LIGHTLY_PLAYED
  MODERATELY_PLAYED
  HEAVILY_PLAYED
  DAMAGED
  GRADED_7
  GRADED_8
  GRADED_9
  PSA_10
  BGS_10
  CGC_10
  SGC_10
}

// A point-in-time price observation for a card, from a given source/price type. This is
// the merged time series that powers the ticker and trend engine — both periodic guide
// price pulls AND individual sold transactions land here, at their real timestamps, so a
// sale that beats the guide price shows up as a spike/new-high immediately rather than
// waiting for PriceCharting's aggregate to catch up.
model PriceSnapshot {
  id         String      @id @default(cuid())
  cardId     String      @map("card_id")
  card       Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  source     PriceSource
  priceType  String      @map("price_type") // e.g. "loose", "cib", "new", "graded-9", "graded-10"
  price      Int // cents
  capturedAt DateTime    @default(now()) @map("captured_at")

  @@index([cardId, priceType, capturedAt])
  @@map("price_snapshots")
}

enum PriceSource {
  /// PriceCharting's aggregate per-condition guide price (/api/product). Can lag real demand.
  PRICECHARTING_GUIDE
  /// An actual sold transaction on PriceCharting's own marketplace (/api/offers?status=sold).
  PRICECHARTING_SALE
  /// An actual sold transaction on eBay.
  EBAY_SALE
  /// TCGPlayer's aggregate Market Price for a product — itself computed from recent sales,
  /// so it's a second independent real-market signal alongside PriceCharting's guide price
  /// and eBay sold comps. Magic/Pokemon/Yu-Gi-Oh only — TCGPlayer doesn't carry sports
  /// cards. See src/lib/tcgplayer.ts.
  TCGPLAYER_MARKET
  MANUAL
}

// An individual sold transaction — PriceCharting's own marketplace, or eBay — kept with its
// full listing details (title/link/image) for display. Its price is also mirrored into
// PriceSnapshot (see above) so it drives the trend engine like any other price point.
model MarketSale {
  id        String      @id @default(cuid())
  cardId    String      @map("card_id")
  card      Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  source    PriceSource
  title     String
  price     Int // cents
  itemUrl   String      @map("item_url")
  imageUrl  String?     @map("image_url")
  condition String?
  soldAt    DateTime    @map("sold_at")
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([itemUrl])
  @@index([cardId, soldAt])
  @@map("market_sales")
}

// A generated signal — "trending up", "time to sell", etc — surfaced from the trend engine.
model Alert {
  id           String    @id @default(cuid())
  cardId       String    @map("card_id")
  card         Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  type         AlertType
  priceType    String    @map("price_type")
  message      String
  changePct    Float     @map("change_pct")
  fromPrice    Int       @map("from_price") // cents
  toPrice      Int       @map("to_price") // cents
  windowDays   Int       @map("window_days")
  acknowledged Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([cardId, createdAt])
  @@index([acknowledged, createdAt])
  @@map("alerts")
}

enum AlertType {
  TRENDING_UP
  TRENDING_DOWN
  SELL_SIGNAL
  NEW_HIGH
  /// A same-card different-print-variant sibling (e.g. Cosmos Holo vs Holo) is priced
  /// meaningfully higher than what's on file — possible mislabeled/misidentified variant.
  VARIANT_MISMATCH
  /// A raw/ungraded card's graded value clears the grading-cost floor with a holding or
  /// rising trend — see src/lib/gradingRecs.ts.
  GRADING_OPPORTUNITY
}

// --- Stock watch: a separate feature from card price tracking above. Watches specific
// retail product/search pages and alerts on restocks or brand-new listings (e.g. a new
// Pokemon Elite Trainer Box going live at GameStop/Walmart/Target/Best Buy) — see
// src/lib/stockWatch.ts and src/lib/retailers/. Deliberately notify-only: it never adds to
// cart or checks out, since that crosses into scalper-bot territory.

enum Retailer {
  GAMESTOP
  WALMART
  TARGET
  BESTBUY
}

enum WatchKind {
  /// A specific known product page — alert when it flips from out-of-stock to in-stock.
  PRODUCT
  /// A search/category page for a keyword (e.g. "Elite Trainer Box") — alert when a
  /// brand-new listing appears that wasn't there on the last check.
  SEARCH
}

// A retailer page the user wants watched, checked on a schedule (see stockWatch.ts).
model WatchTarget {
  id            String    @id @default(cuid())
  retailer      Retailer
  kind          WatchKind @default(PRODUCT)
  label         String
  url           String
  // Best Buy SKU, when known — lets the checker use Best Buy's official Products API
  // directly instead of scraping. Required for BESTBUY + PRODUCT.
  sku           String?
  // Search keyword, required for SEARCH kind (e.g. "Pokemon Elite Trainer Box").
  keyword       String?
  active        Boolean   @default(true)
  // Last known stock state for PRODUCT targets. Null = not checked yet.
  inStock       Boolean?
  lastTitle     String?
  lastPriceCents Int?     @map("last_price_cents")
  lastCheckedAt DateTime? @map("last_checked_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  seenProducts SeenProduct[]
  stockAlerts  StockAlert[]

  @@unique([url])
  @@map("watch_targets")
}

// A product already seen on a SEARCH-kind target, so only genuinely new listings alert.
model SeenProduct {
  id            String      @id @default(cuid())
  watchTargetId String      @map("watch_target_id")
  watchTarget   WatchTarget @relation(fields: [watchTargetId], references: [id], onDelete: Cascade)
  externalId    String      @map("external_id") // sku or product URL, used to dedupe
  title         String
  url           String
  firstSeenAt   DateTime    @default(now()) @map("first_seen_at")

  @@unique([watchTargetId, externalId])
  @@map("seen_products")
}

// A generated restock/new-listing signal for a watch target.
model StockAlert {
  id            String      @id @default(cuid())
  watchTargetId String      @map("watch_target_id")
  watchTarget   WatchTarget @relation(fields: [watchTargetId], references: [id], onDelete: Cascade)
  message       String
  url           String
  acknowledged  Boolean     @default(false)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([watchTargetId, createdAt])
  @@index([acknowledged, createdAt])
  @@map("stock_alerts")
}
