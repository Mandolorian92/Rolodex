# Postgres connection string used by Prisma (migrate, studio, and the app at runtime).
DATABASE_URL="postgresql://user:password@localhost:5432/rolodex?schema=public"

# PriceCharting API key (https://www.pricecharting.com/api-documentation) — required.
# PriceCharting aggregates eBay sold data into per-condition market prices; this is the
# app's primary price source for the ticker.
PRICECHARTING_API_KEY=

# eBay developer app credentials (https://developer.ebay.com/my/keys) — optional.
# Used to pull raw sold comps (requires Marketplace Insights API access, which eBay grants
# on request) and, as a fallback, active listing search. The app works without these, just
# without the "recent eBay comps" section on each card.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
