# Postgres connection string used by Prisma (migrate, studio, and the app at runtime).
DATABASE_URL="postgresql://user:password@localhost:5432/rolodex?schema=public"

# PriceCharting API key (https://www.pricecharting.com/api-documentation) — required.
# Find yours on your Subscription page -> "API/Download". Requires a paid subscription.
# PriceCharting is the app's primary price source for the ticker.
PRICECHARTING_API_KEY=

# Your PriceCharting seller/user id — optional, only needed to use "Import from
# PriceCharting" on the Collection page. Find it in the URL of your collection page:
# pricecharting.com/offers?...&seller=THIS_PART&status=collection
PRICECHARTING_SELLER_ID=

# eBay developer app credentials (https://developer.ebay.com/my/keys) — optional.
# Used to pull raw sold comps (requires Marketplace Insights API access, which eBay grants
# on request) and, as a fallback, active listing search. The app works without these, just
# without the "recent eBay comps" section on each card.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Email notifications when a new alert fires (trending up/down, new high, sell signal) —
# optional. Get a free API key at https://resend.com (no custom domain needed to start;
# the default "onboarding@resend.dev" sender works for testing). Without these set, alerts
# still work, they just only show up in-app on the /alerts page.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM="Rolodex <onboarding@resend.dev>"

# Base URL used to build links back to the app in notification emails.
APP_BASE_URL="http://localhost:3000"

# Skip trending/new-high/sell-signal alerts entirely for a card currently worth less than
# this — a 140% swing on a $1.60 card isn't actionable. Optional, defaults to 5 (i.e. $5).
ALERT_MIN_VALUE_USD=5

# Minimum dollar premium (graded value minus raw value) for a grading recommendation to
# fire — a rough floor for typical grading + shipping cost. Optional, defaults to 20.
GRADING_MIN_PREMIUM_USD=20

# Best Buy's free Products API key (https://developer.bestbuy.com/) — optional, only needed
# for Stock watch (/stock-watch) targets on Best Buy. Unlike GameStop/Walmart/Target, Best
# Buy's official API gives real-time stock status directly, no scraping required, so it's
# the most reliable retailer to watch if a product's carried there.
BESTBUY_API_KEY=
